{
  "name": "neuratrack",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "NeuraTrack — camera-only neuromotor monitoring PWA. Monitoring tool, not a diagnostic device.",
  "scripts": {
    "start": "npm run build && electron desktop/main.cjs",
    "app": "npm start",
    "test:desktop": "npm run build && node tests/desktop-smoke.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test:signal": "node src/lib/test-signal.mjs",
    "test": "npm run test:signal && node src/lib/test-measurements.mjs && node --test tests/storage-report.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@mediapipe/tasks-vision": "0.10.17",
    "chart.js": "^4.4.4",
    "idb": "^8.0.0",
    "jspdf": "4.2.1",
    "lenis": "^1.3.25",
    "motion": "^12.42.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.4",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "fake-indexeddb": "^6.2.6",
    "vite": "8.3.5"
  }
}
